 	std::vector<InputBinding>  inputs;
 	std::vector<OutputBinding> outputs;
 	std::vector<uint32_t>      interface_variables;
+
+	// [LOCAL PATCH RDNA1] Loop guard: counter iterasi per loop header guest.
+	// Counter dinaikkan sekali per iterasi; begitu melewati LoopGuardLimit()
+	// semua cabang keluar loop (yang menuju blok merge) dipaksa keluar. Ini
+	// mencegah guest loop tanpa batas iterasi menggantungkan GPU
+	// (ring gfx timeout -> device lost). Cabang yang sudah ada di-"racuni"
+	// kondisinya supaya struktur SPIR-V tetap valid (tanpa predecessor OpPhi
+	// baru dan tanpa blok keluar tambahan di dalam loop).
+	struct LoopGuardHeader {
+		const IR::Block* header   = nullptr;
+		uint32_t         variable = 0;
+	};
+	struct LoopGuardExit {
+		const IR::Block* site     = nullptr;
+		const IR::Block* merge    = nullptr;
+		size_t           variable = 0;
+	};
+	std::vector<LoopGuardHeader> loop_guard_headers;
+	std::vector<LoopGuardExit>   loop_guard_exits;
 };
 
